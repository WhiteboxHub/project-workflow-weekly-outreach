MAIN_API_BASE_URL=http://localhost:8000/api
LOG_LEVEL=DEBUG
API_BEARER_TOKEN=put_your_secure_secret_token_here
REDIS_URL=redis://localhost:6379/0

# Login credentials — used to auto-refresh the bearer token when it expires
API_LOGIN_EMAIL=your_login_email@example.com
API_LOGIN_PASSWORD=your_login_password

# Reporting — separate account that sends the daily run report
REPORT_FROM_EMAIL=your_report_email@example.com
REPORT_FROM_PASSWORD=your_app_password
REPORT_RECIPIENT_EMAIL=recipient@example.com
REPORT_SMTP_HOST=smtp.gmail.com
REPORT_SMTP_PORT=587

SECRET_KEY=your-secret-key

# Optional (for Gmail API sending, SMTP doesn't need this)
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret

# Local DuckDB Campaigns (set to true to use DuckDB)
USE_LOCAL_DUCKDB_CAMPAIGNS=true
DUCKDB_CAMPAIGN_PATH=./data/campaigns.duckdb

# Scheduler Polling Rate (in seconds)
SCHEDULER_INTERVAL_SECONDS=300

# Max emails to dispatch per candidate per scheduler run
# Set this to your total daily limit across ALL SMTP accounts combined
SCHEDULER_BATCH_SIZE=1000

# Email send delay — random wait between each email to appear more human-like
# Increase these if getting "Message Blocked" rejections from recipient servers
# 60–300 seconds recommended for new/warming Gmail accounts
MIN_DELAY_SECONDS=60
MAX_DELAY_SECONDS=300
